# Dependencies and package archives
node_modules/
*.tgz

# Build outputs — the hidden `.dmd/` workspace owns every generated artifact;
# the docs root keeps ONLY documentation plus the `index.html` symlink.
dist/
docs/**/.dmd/
# Preserve authored docs widgets while ignoring every generated workspace asset.
!docs/.dmd/
docs/.dmd/*
!docs/.dmd/.components/
docs/.dmd/.components/*
!docs/.dmd/.components/*.svelte
!docs/.dmd/.components/*.tsx
!docs/.dmd/.components/*.ts
!docs/.dmd/.components/setup.js
!docs/examples/local-docs/.dmd/
docs/examples/local-docs/.dmd/*
!docs/examples/local-docs/.dmd/.components/
docs/examples/local-docs/.dmd/.components/*
!docs/examples/local-docs/.dmd/.components/OrbitCounter.svelte
docs/**/.dist/
docs/**/.singlefile/
docs/**/_manifest.json
docs/**/_docs.js
docs/**/docmedown.iife.js
docs/**/docmedown.web.js
docs/**/docmedown-mermaid.js
# Generated static-site pages and AI context artifacts (rebuilt on every build;
# the root symlink stays tracked so fresh clones pass hosting tests).
docs/**/llms.txt
docs/**/llms-full.txt
docs/**/okf.json
docs/**/llms.*.txt
docs/**/llms-full.*.txt
docs/**/okf.*.json
# Static locale routes and engine-provided guides; Markdown sources are never ignored.
docs/*/index.html
docs/**/DMD*/**/index.html
docs/**/SKILL.md
docs/**/sitemap.xml
docs/**/robots.txt
docs/**/404.html
docs/**/SKILL/
docs/guides/*/index.html
docs/getting-started/
docs/showcase/
docs/configuration/
docs/examples/index.html
docs/examples/*/index.html
docs/examples/*/getting-started/
docs/examples/*/guides/*/index.html
docs/**/packing/
!docs/index.html
# The `.dmd/` workspace is regenerated on every build; markers inside it are
# never tracked either.
docs/**/.nojekyll

# Local configuration and credentials
.env
.env.*
!.env.example
.npmrc

# Logs and coverage
*.log
coverage/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/

# Local scratch and preview directories
scratch/
.preview/