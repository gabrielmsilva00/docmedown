      { "code": "de", "label": "Deutsch" },
      { "code": "zh-CN", "label": "简体中文" }
    ],
    "fallbackToDefault": true
  },
  "url": "https://gabrielmsilva00.github.io/docmedown",
  "theme": {
    "family": "atlas",
    "density": "comfortable",
    "defaultMode": "auto",
