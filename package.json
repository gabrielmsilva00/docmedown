{
  "name": "docmedown",
  "version": "0.3.0-alpha.0",
  "description": "The simplest MarkDown documenter yet. CLI, web script, and static-site compiler with AI-native distribution.",
  "main": "./dist/docmedown.cjs",
  "module": "./dist/docmedown.mjs",
  "types": "./dist/types/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/ui/index.d.ts",
      "import": "./dist/docmedown.mjs",
      "require": "./dist/docmedown.cjs"
    },
    "./iife": "./dist/docmedown.iife.js"
  },
  "unpkg": "./dist/docmedown.iife.js",
  "jsdelivr": "./dist/docmedown.iife.js",
  "bin": {
    "docmedown": "bin/docmedown.js",
    "dmd": "bin/docmedown.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:runtime": "vite build --watch",
    "build:runtime": "vite build",
    "build:web": "vite build --config vite.config.web.mts",
    "build:engines": "node ./scripts/build-engines.mjs",
    "build:cli": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build:types": "tsc -p tsconfig.runtime.json",
    "build": "npm run build:runtime && npm run build:web && npm run build:engines && npm run build:cli && npm run build:types",
    "docmedown": "node ./bin/docmedown.js",
    "dmd": "node ./bin/docmedown.js",
    "init:docs": "node ./bin/docmedown.js init",
    "serve": "node ./bin/docmedown.js serve ./docs",
    "dev": "node ./bin/docmedown.js serve ./docs",
    "build:docs": "node ./bin/docmedown.js build ./docs",
    "build:docs:watch": "node ./bin/docmedown.js build ./docs --watch",
    "build:offline": "node ./bin/docmedown.js build ./docs",
    "config:docs": "node ./bin/docmedown.js config ./docs/docs.json",
    "test": "npx tsx --test tests/parser.test.ts tests/scanner.test.ts tests/theme-schema.test.ts tests/runtime-integration.test.ts tests/package-smoke.test.ts tests/hosting.test.ts tests/deploy.test.ts tests/home.test.ts tests/svelte-imports.test.ts tests/static-site.test.ts tests/static-router.test.ts tests/mcp.test.ts tests/tabs-builtin.test.ts tests/card-builtin.test.ts tests/component-body.test.ts tests/mermaid-loader.test.ts tests/splash.test.ts tests/navigation.test.ts",
    "test:artifacts": "npx tsx --test tests/offline-artifact.test.ts",
    "test:bundle": "npx tsx --test tests/bundle-size.test.ts",
    "test:release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:docs && npm run test:artifacts && npm run test:bundle && npm pack --dry-run",
    "login": "npm login",
    "deploy": "node ./scripts/deploy.mjs",
    "deploy:dry-run": "npm run deploy -- --dry-run",
    "prepublishOnly": "npm run test:release"
  },
  "keywords": [
    "markdown",
    "documentation",
    "docs",
    "docusaurus",
    "docsify",
    "svelte",
    "spa",
    "cli",
    "offline-docs",
    "github-docs"
  ],
  "author": "Gabriel M. Silva",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielmsilva00/docmedown.git"
  },
  "bugs": {
    "url": "https://github.com/gabrielmsilva00/docmedown/issues"
  },
  "homepage": "https://github.com/gabrielmsilva00/docmedown#readme",
  "packageManager": "npm@11.16.0",
  "overrides": {
    "tsup": {
      "esbuild": "0.28.2"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "lit": "^3.3.3",
    "mime-types": "^2.1.35",
    "open": "^10.1.0",
    "prompts": "^2.4.2",
    "svelte": "^5.57.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.5.0",
    "@types/prismjs": "^1.26.6",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.5.12",
    "katex": "^0.16.11",
    "marked": "^14.1.1",
    "mermaid": "^11.17.2",
    "minisearch": "^7.1.0",
    "prismjs": "^1.29.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vite-plugin-css-injected-by-js": "^5.0.2"
  }
}
