{
  "name": "docmedown",
  "version": "0.9.8",
  "description": "The simplest MarkDown documenter yet. CLI, web script, and static-site compiler with AI-native distribution.",
  "author": "Gabriel M. P. da Silva",
  "license": "Apache-2.0",
  "homepage": "https://github.com/gabrielmsilva00/docmedown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielmsilva00/docmedown.git"
  },
  "bugs": {
    "url": "https://github.com/gabrielmsilva00/docmedown/issues"
  },
  "keywords": [
    "markdown",
    "documentation",
    "docs",
    "docusaurus",
    "docsify",
    "svelte",
    "spa",
    "cli",
    "offline-docs",
    "github-docs",
    "mcp",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.16.0",
  "main": "./dist/docmedown.cjs",
  "module": "./dist/docmedown.mjs",
  "types": "./dist/types/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/ui/index.d.ts",
      "import": "./dist/docmedown.mjs",
      "require": "./dist/docmedown.cjs"
    },
    "./motion": {
      "types": "./dist/types/runtime/motion.d.ts",
      "import": "./dist/docmedown.mjs",
      "require": "./dist/docmedown.cjs"
    },
    "./iife": "./dist/docmedown.iife.js"
  },
  "unpkg": "./dist/docmedown.iife.js",
  "jsdelivr": "./dist/docmedown.iife.js",
  "bin": {
    "docmedown": "bin/docmedown.js",
    "dmd": "bin/docmedown.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:fast": "node ./scripts/build.mjs --fast",
    "build:docs": "node ./bin/docmedown.js build ./docs",
    "build:docs:watch": "node ./bin/docmedown.js build ./docs --watch",
    "dev": "node ./bin/docmedown.js serve ./docs",
    "dev:runtime": "vite build --watch",
    "dev:mcp": "node ./bin/docmedown.js mcp ./docs",
    "serve": "node ./bin/docmedown.js serve ./docs",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node ./scripts/test-unit.mjs",
    "test:mcp": "npx tsx --test tests/mcp.test.ts",
    "test:mcp:client": "node ./scripts/test-mcp-client.mjs",
    "test:artifacts": "npx tsx --test tests/offline-artifact.test.ts",
    "test:bundle": "npx tsx --test tests/bundle-size.test.ts",
    "test:hosting": "npx tsx --test tests/hosting.test.ts",
    "test:pages": "node ./scripts/test-pages.mjs",
    "test:release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:mcp && npm run build:docs && npm run test:hosting && npm run test:artifacts && npm run test:bundle && npx tsx --test tests/package-smoke.test.ts && npm pack --dry-run",
    "doctor": "node ./bin/docmedown.js doctor ./docs",
    "doctor:project": "node ./scripts/doctor-project.mjs",
    "validate": "node ./bin/docmedown.js validate ./docs",
    "config:docs": "node ./bin/docmedown.js config ./docs/.dmd/.config/docs.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('docs/.dmd', { recursive: true, force: true }); fs.rmSync('docs/.dist', { recursive: true, force: true })\"",
    "deploy": "node ./scripts/deploy.mjs",
    "deploy:dry-run": "npm run deploy -- --dry-run",
    "prepublishOnly": "npm run test:release",
    "commit": "node ./scripts/commit.mjs",
    "commit:fast": "node ./scripts/commit.mjs --fast"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.2"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "mime-types": "^2.1.35",
    "open": "^10.1.0",
    "prompts": "^2.4.2",
    "qrcode-terminal": "^0.12.0",
    "svelte": "^5.57.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.5.0",
    "@types/prismjs": "^1.26.6",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.5.12",
    "katex": "^0.16.11",
    "marked": "^14.1.1",
    "minisearch": "^7.1.0",
    "motion": "^13.4.4",
    "pele": "^1.6.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vite-plugin-css-injected-by-js": "^5.0.2"
  }
}
