{
  "$schema": "https://raw.githubusercontent.com/gabrielmsilva00/docmedown/main/schemas/docs.schema.json",
  "name": "My Project Docs",
  "tagline": "The simplest Markdown documentation yet",
  "description": "Fast, modern documentation created with DocMeDown",
  "version": "1.0.0",
  "rootDoc": "README.md",
  "i18n": {
    "defaultLocale": "en",
    "locales": [
      { "code": "en", "label": "English" },
      { "code": "pt-BR", "label": "Português (Brasil)" },
      { "code": "es", "label": "Español" },
      { "code": "fr", "label": "Français" },
      { "code": "de", "label": "Deutsch" },
      { "code": "zh-CN", "label": "简体中文" }
    ],
    "fallbackToDefault": true
  },
  "home": "README.md",
  "theme": {
    "family": "atlas",
    "density": "comfortable",
    "defaultMode": "auto",
    "codeTheme": "github"
  },
  "nav": [
    { "label": "Overview", "href": "#/README" },
    { "label": "Quickstart", "href": "#/getting-started" },
    { "label": "Guides", "href": "#/guides/custom-components" }
  ],
  "autoIndex": {
    "enabled": true,
    "sort": "natural",
    "defaultCollapsed": false
  },
  "search": {
    "enabled": true,
    "placeholder": "Search documentation..."
  },
  "offline": {
    "embedNestedDocs": true
  }
}
