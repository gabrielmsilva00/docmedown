{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "declaration": true,
    "declarationDir": "./dist/types",
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": [
    "src/runtime/**/*",
    "src/ui/index.ts",
    "src/ui/svelte-shim.d.ts",
    "src/ui/doc-context.svelte.ts",
    "src/ui/registry.ts",
    "src/ui/theme.svelte.ts",
    "src/types/**/*"
  ]
}